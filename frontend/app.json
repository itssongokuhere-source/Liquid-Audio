{
  "expo": {
    "name": "LiquidAudio",
    "slug": "frontend",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icons/rose-square.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.rhythmglassui.wnm9ul",
      "buildNumber": "2",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/rose-foreground.png",
        "backgroundImage": "./assets/icons/rose-background.png",
        "backgroundColor": "#8B103C"
      },
      "package": "com.emergent.rhythmglassui.wnm9ul",
      "versionCode": 2,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "@react-native-vector-icons/ionicons",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Ocean",
            "ios": "./assets/icons/ocean-square.png",
            "android": {
              "foregroundImage": "./assets/icons/ocean-foreground.png",
              "backgroundImage": "./assets/icons/ocean-background.png",
              "backgroundColor": "#2563EB"
            }
          },
          {
            "name": "Aurora",
            "ios": "./assets/icons/aurora-square.png",
            "android": {
              "foregroundImage": "./assets/icons/aurora-foreground.png",
              "backgroundImage": "./assets/icons/aurora-background.png",
              "backgroundColor": "#0E7490"
            }
          },
          {
            "name": "Midnight",
            "ios": "./assets/icons/midnight-square.png",
            "android": {
              "foregroundImage": "./assets/icons/midnight-foreground.png",
              "backgroundImage": "./assets/icons/midnight-background.png",
              "backgroundColor": "#1E293B"
            }
          },
          {
            "name": "Gold",
            "ios": "./assets/icons/gold-square.png",
            "android": {
              "foregroundImage": "./assets/icons/gold-foreground.png",
              "backgroundImage": "./assets/icons/gold-background.png",
              "backgroundColor": "#B45309"
            }
          },
          {
            "name": "Violet",
            "ios": "./assets/icons/violet-square.png",
            "android": {
              "foregroundImage": "./assets/icons/violet-foreground.png",
              "backgroundImage": "./assets/icons/violet-background.png",
              "backgroundColor": "#7C3AED"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
